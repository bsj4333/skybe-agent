# Copy to .env in this directory. Never commit the real file.
OPENAI_API_KEY=
# Claude runs every model call. OpenAI remains only for legacy embeddings.
ANTHROPIC_API_KEY=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Public OAuth client ID. Leave empty to hide the Google Drive import button.
GOOGLE_CLIENT_ID=
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SHARED_POOLER_HOST:6543/postgres

# Optional model settings
SKIVE_MODEL=claude-haiku-5-5
SKIVE_EFFORT=low
SKIVE_JUDGE_MODEL=claude-haiku-5-5
SKIVE_PROJECT_AGENT_MODEL=claude-haiku-5-5
SKIVE_ESSAY_MODEL=claude-sonnet-5-5
SKIVE_ESSAY_EFFORT=medium
