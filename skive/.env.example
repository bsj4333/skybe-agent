# Copy to .env in this directory. Never commit the real file.
OPENAI_API_KEY=
# Prepared for future Claude support; not yet used by the current LLM adapter.
ANTHROPIC_API_KEY=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_SHARED_POOLER_HOST:6543/postgres

# Optional model settings
SKIVE_MODEL=gpt-4o-mini
SKIVE_JUDGE_MODEL=gpt-4o
SKIVE_PROJECT_AGENT_MODEL=gpt-6-luna
