#!/bin/sh
# Blocks secrets before they reach the public repository.
root="$(git rev-parse --show-toplevel)"
for python in "$root/skive/.venv/Scripts/python.exe" "$root/skive/.venv/bin/python" python3 python; do
  if command -v "$python" >/dev/null 2>&1 || [ -x "$python" ]; then
    exec "$python" "$root/skive/scripts/check_secrets.py"
  fi
done
echo "secret check could not find Python" >&2
exit 1
